DATABASE_URL=
# Optional: app connection pool size and client acquire timeout (defaults 15 / 10000 ms).
DATABASE_POOL_MAX=
DATABASE_POOL_ACQUIRE_TIMEOUT_MS=
# A bounded read (boundedQuery, #1377) that succeeds after more than this many ms is logged as slow; empty = 20000, 0 = off.
BOUNDED_QUERY_SLOW_MS=
# Storefront enrichment links drain interval in ms (#446); 0 turns the background sync off. Default 5000.
ENRICHMENT_LINK_SYNC_INTERVAL_MS=
# Production servers request the most visited storefront pages and the slow sitemap files once at start (#448, #778); 0 turns it off.
STOREFRONT_WARMUP=
# 0 keeps the storefront listing caches in process memory only, without the shared storefront_listing_cache table (#957); price-sorted pages 1-20 then also stop taking their ids from the stored price orders (#1389).
LISTING_CACHE_PERSIST=
# Most milliseconds a listing count, page ids, facets or search result wait for a reload before the earlier value is served (#771); empty = 250.
LISTING_EPOCH_WAIT_MS=
# 0 reads a listing's count, first page ids and facets with separate statements again instead of one scan (#1367).
LISTING_ONE_SCAN=
# Server-side limit (ms) of a catalog listing/search read (#1377); empty = 55000, just under the CDN/ALB origin timeout of 60 s; 0 = no limit (reads as before).
LISTING_STATEMENT_TIMEOUT_MS=
# Server-side limit (ms) of a header type-ahead read (/api/search/suggest, #1398); empty = 5000, 0 = listing limit.
SUGGEST_STATEMENT_TIMEOUT_MS=
# Ms a type-ahead hit set, spell-correction scope or synonym load that hit its limit is not tried again (#1416); empty = 30000, 0 = try every time.
SEARCH_FAILURE_HOLD_MS=
# 0 reads price-sorted pages past page 20 live again instead of slicing the listing's stored price order (#1369); pages 1-20 then price their own ids again (#1389).
LISTING_PRICE_ORDER=
# Largest listing (ids) whose whole price order is stored; larger ones read deep price pages live (#1369). Empty = 1000000.
LISTING_PRICE_ORDER_MAX_IDS=
# 0 reads a filtered listing's price pages past page 20 live again instead of storing its order (#1390); LISTING_PRICE_ORDER=0 turns them off too.
LISTING_PRICE_ORDER_FILTERED=
# Smallest filtered listing (ids; a brand, property, availability, model or garage vehicle filter, never a search) whose deep price pages slice a stored order; an in/out-of-stock filter stores at any size (#1390). Empty = 20000.
LISTING_PRICE_ORDER_FILTERED_MIN_IDS=
# Most ids the filtered listings' stored orders hold together (~16 bytes an id): a filtered build first evicts the rows unused for an hour, then the least recently used; a larger listing reads live (#1390). Empty = 8000000.
LISTING_PRICE_ORDER_FILTERED_MAX_TOTAL_IDS=
# 0 reads every price-sorted search live again (hits, live count and priced page per request) instead of slicing its order kept in memory (#1425).
SEARCH_PRICE_ORDER=
# Most ids the price-sorted searches' cached orders hold together in a process (16 bytes an id; the least recently used keys go first). Empty = 1000000.
SEARCH_PRICE_ORDER_MAX_IDS=
# Most vehicle types of partly matched models a part + vehicle search reads in its turn (#1395); a broader reading ("tdi", "dizel") is read after the other splits, longest vehicle phrase first (#1407). Empty = 500; 0 defers every partly matched reading.
VEHICLE_SEARCH_MAX_LIVE_TYPES=
# Most product hits a deferred (broad) vehicle reading may have and still be read as a vehicle (#1407); over it the search falls back to its plain matches. Empty = 25000; 0 = no deferred readings (as before #1407).
VEHICLE_SEARCH_MAX_DEFERRED_HITS=
# Milliseconds between sitemap cache refreshes (#778); empty = 3 hours.
SITEMAP_WARMUP_INTERVAL_MS=
ADMIN_EMAIL=
ADMIN_PASSWORD=
DINAMIK_BASE=
DINAMIK_APIKEY=
DINAMIK_SECRETKEY=
# Local only: the API allow-lists the VPS address. Tunnel through it with
# ssh -N -L 18443:dinamikapp-api.dinamik.online:443 root@173.249.36.2 and set 127.0.0.1:18443.
DINAMIK_DIRECT_TUNNEL=
# Supplier egress through the VPS proxy when not running on the VPS (infra/squid/README.md, #411).
# Unset = direct. SUPPLIER_EGRESS_PROXY_FOR defaults to dinamik.
SUPPLIER_EGRESS_PROXY=
SUPPLIER_EGRESS_PROXY_FOR=
# manual = the supplier scheduler is off on purpose (local development; data refreshed from /yonetim/tedarikciler).
# Its missing heartbeat is then not reported as a fault. Leave unset in production.
SUPPLIER_SCHEDULER=
# Minutes per scheduler tick in which new Dinamik brands may start (default 10).
DINAMIK_TICK_MINUTES=
# Hours between automatic product-match refreshes after supplier changes (default 6; 0 = off).
PRODUCT_MATCH_INTERVAL_HOURS=
BASBUG_BASE_URL=
BASBUG_USERNAME=
BASBUG_PASSWORD=
BASBUG_CLIENT_ID=
BASBUG_CLIENT_SECRET=
BASBUG_FIRMA_ADI=
BASBUG_SAMPLE_CODE=
BASBUG_SAMPLE_GROUP=
BASBUG_SAMPLE_WAREHOUSE=
BASBUG_SAMPLE_CODES=
# SETA B2B list (GET /seta/products, XApiKey header). Base URL defaults to https://b2b-api.ismyazilim.com/seta/products.
SETA_API_KEY=
SETA_BASE_URL=
SITE_URL=
# Storefront analytics (#644). Empty = no tag is loaded. Read at runtime by the app task.
GA4_MEASUREMENT_ID=
# Self-hosted Plausible CE (#1290): internal base URL. Empty = no script tag and /stats/* answers inertly. Read at runtime by the app task, never NEXT_PUBLIC_.
PLAUSIBLE_URL=
# PLAUSIBLE_DOMAIN=getirbakim.com
# Advertising tags (#676), loaded only with the marketing consent. Empty = no tag. Read at runtime by the app task, never NEXT_PUBLIC_.
# GOOGLE_ADS_ID=AW-…; GOOGLE_ADS_PURCHASE_LABEL = the purchase conversion's label (ignored without GOOGLE_ADS_ID); META_PIXEL_ID = digits only.
GOOGLE_ADS_ID=
GOOGLE_ADS_PURCHASE_LABEL=
META_PIXEL_ID=
# IndexNow (#645, docs/indexnow.md): production only, needs SITE_URL; leave empty locally. Key served as /<key>.txt (openssl rand -hex 16); daily URL budget, default 50000, 0 = no limit.
INDEXNOW_KEY=
INDEXNOW_MAX_URLS=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
TAMI_MERCHANT_NUMBER=
TAMI_TERMINAL_NUMBER=
TAMI_SECRET_KEY=
TAMI_JWK_KID=
TAMI_JWK_K=
TAMI_PAYMENT_API_BASE_URL=
TAMI_PORTAL_BASE_URL=
# New card payments open only when true; callbacks and reconciliation always run.
TAMI_CHECKOUT_ENABLED=false
# At least 32 random characters; bearer for POST /api/payments/tami/reconcile (systemd timer).
PAYMENT_RECONCILIATION_SECRET=
# Order confirmation email (#951, docs/commerce.md), also password reset (#1257) and e-mail verification (#1258) links.
# Empty = nothing is sent, each order logs "Order email skipped" (locally the reset and verification links are logged
# instead). Without mail, new customer signups cannot be verified and their accounts never open.
# smtp: any SMTP server, e.g. Amazon SES SMTP (email-smtp.eu-central-1.amazonaws.com:587; SES SMTP credentials are not
# IAM keys; MAIL_FROM must be on a verified domain). ses: Amazon SES v2 API with the default AWS credential chain (ECS task
# role, no keys; region SES_REGION, then AWS_REGION, default eu-central-1). file: writes .eml files to MAIL_FILE_DIR (local only, refused in production).
MAIL_TRANSPORT=
# e.g. Getirbakim <siparis@getirbakim.com>
MAIL_FROM=
# Defaults to hey@getirbakim.com.
MAIL_REPLY_TO=
SES_REGION=
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (port 465); otherwise STARTTLS is required.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Defaults to .local/mail.
MAIL_FILE_DIR=
# Customer signup, e-mail verification and password reset (#1303, docs/commerce.md). In production they open only with
# `on` AND a working MAIL_TRANSPORT above (unset = off); elsewhere they are open unless `off`. Read at request time.
ACCOUNT_EMAIL=
# Geliver shipping labels (#960, docs/commerce.md). Without a token the ship dialog has no Geliver tab.
GELIVER_API_TOKEN=
# Only `live` buys real (paid) Yurtiçi labels; anything else creates free Geliver test labels.
GELIVER_MODE=test
# A production server refuses test mode (orders would be marked shipped with labels that never move); 1 allows it.
GELIVER_ALLOW_TEST_IN_PRODUCTION=
# At least 32 random characters (openssl rand -hex 32); authenticates POST /api/shipping/geliver/webhook.
GELIVER_WEBHOOK_SECRET=
# MinIO (local, VPS): endpoint + static keys. Amazon S3 (AWS): leave the endpoint and keys empty; the ECS task role
# is used and S3_REGION names the buckets' Region.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=product-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# BakımX partner API (GET /api/partner/v1/products). Comma separated "partnerCode:key" pairs, each key at least
# 16 characters; unset means every partner request gets 401. Remove one pair to revoke that partner.
PARTNER_API_KEYS=
# Fallback partner discount off the storefront price before VAT, in basis points (1500 = 15%); never below cost.
# A discount set per partner in /yonetim/partnerler (#1130) overrides it.
PARTNER_B2B_DISCOUNT_BPS=0
# Partner orders (#426, docs/partner-order-contract.md). HMAC secret for order quotes, at least 32 random characters;
# unset or shorter means quotes and orders answer 503. Rotating it voids quotes issued in the last 15 minutes.
PARTNER_QUOTE_SIGNING_SECRET=
# Default open-order limit per partner in kuruş, VAT and shipping included; a limit set in /yonetim/partnerler overrides it.
# Counted: undelivered, uncancelled partner orders + delivered ones not yet marked invoiced + the new one.
# Unset (and no panel limit) means the partner's orders are refused.
PARTNER_ORDER_LIMIT_KURUS=
# Partner order webhooks (#1002, docs/partner-order-contract.md "Webhooks"): JSON, partner code -> endpoint, e.g.
# {"bakimx":{"url":"https://partner.example/hooks/getirbakim","secret":"<at least 32 random characters>","enabled":true}}.
# https only in production, no credentials in the URL. A broken or disabled entry holds that partner's events, broken
# JSON holds every partner's (they wait, logged, up to 72 h); a partner with no entry (or unset) gets none: skipped.
PARTNER_WEBHOOKS_JSON=
# Signed guest order links in the confirmation email (#1034): at least 32 random characters (openssl rand -base64 48).
# Unset or shorter keeps the old links that open only in the ordering browser. Rotating it voids every link already sent.
ORDER_LINK_SIGNING_SECRET=
# AWS only: storefront bundles uploaded by sync-storefront-production.ts (read by import-storefront-inbound.ts).
INBOUND_BUCKET=
# Shared Next.js cache (cache-handler.mjs). Empty = in-process cache (local, single VPS container).
# AWS: rediss://<Valkey endpoint>:6379 and the Valkey AUTH token.
CACHE_URL=
CACHE_AUTH_TOKEN=
# Server action encryption key shared by every app task (AWS). 32 random bytes, base64: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Content-Security-Policy-Report-Only on pages and the TAMI return page (#1291, src/lib/csp.ts): on unless set to off.
# off drops the header and the per-request nonce (a restart applies it); the enforced phase-1 CSP is unaffected.
CSP_REPORT_ONLY=

# sync-storefront-production.ts sends to AWS only (S3 inbound + ECS task); the VPS target and STOREFRONT_SYNC_TARGET are gone (#563).
# The watermark is .local/storefront-sync/state.aws.json; the first run needs one (--baseline=<ISO>) or an explicit --full.
# See docs/product-enrichment.md.
# A named profile in ~/.aws/config for the Production account (never default).
PRODUCTION_AWS_PROFILE=
PRODUCTION_AWS_REGION=eu-central-1
PRODUCTION_AWS_STACK_PREFIX=GetirbakimProduction
