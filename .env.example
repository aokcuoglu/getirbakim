BASBUG_SAMPLE_CODE=
BASBUG_SAMPLE_GROUP=
BASBUG_SAMPLE_WAREHOUSE=
BASBUG_SAMPLE_CODES=
# SETA B2B list (GET /seta/products, XApiKey header). Base URL defaults to https://b2b-api.ismyazilim.com/seta/products.
