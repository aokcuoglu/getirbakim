# =============================================================================
# PostgreSQL — Prisma 7 driver adapter
# =============================================================================
# Do not commit real credentials.
#
# Local development (docker-compose.local.yml):
#   DATABASE_URL and DIRECT_URL are set in docker-compose.local.yml.
#   They point to postgres:5432 inside the Docker network.
#   For local dev without Docker (bun run dev), use port 54322 on host:
#   DATABASE_URL="postgresql://postgres:local-dev-postgres-password@127.0.0.1:54322/getirbakim"
#   DIRECT_URL="postgresql://postgres:local-dev-postgres-password@127.0.0.1:54322/getirbakim"
#
# Production (docker-compose.yml):
#   DATABASE_URL and DIRECT_URL are set in docker-compose.yml.
#   POSTGRES_PASSWORD must be set in .env.production.
#   Do NOT set DATABASE_URL or DIRECT_URL in .env.production —
#   they are constructed from POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB.
DATABASE_URL="postgresql://postgres:local-dev-postgres-password@127.0.0.1:54322/getirbakim"

# Migrations and direct queries
DIRECT_URL="postgresql://postgres:local-dev-postgres-password@127.0.0.1:54322/getirbakim"

# Database pool sizing
# Local dev (bun run dev, no Docker): 4 (recommended)
# Local Docker: 15 (matches docker-compose.local.yml)
# VPS production: 10 (matches docker-compose.yml)
DATABASE_POOL_MAX=4

# =============================================================================
# PostgreSQL container — Production only
# =============================================================================
# POSTGRES_PASSWORD must be set in .env.production for docker-compose.yml.
# POSTGRES_DB and POSTGRES_USER have defaults (getirbakim / postgres).
# POSTGRES_PASSWORD=change-me-to-a-strong-random-password-in-production

# =============================================================================
# Auth (NextAuth.js) — Local
# =============================================================================
# Required for JWT encryption. Generate with: openssl rand -base64 32
AUTH_SECRET="local-auth-secret-change-in-production-2026"

# =============================================================================
# Public app URL metadata
# =============================================================================
# LOCAL DEV (bun run dev, no Docker):
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# DOCKER LOCAL (docker-compose.local.yml) — use 3001:
# NEXT_PUBLIC_SITE_URL=http://localhost:3001
# NEXT_PUBLIC_APP_URL=http://localhost:3001

# Build version — set during CI/CD or release

# SEO indexing control
# Set to "true" in production to allow search engine indexing.
# Any other value (or unset) will block indexing via robots.txt and noindex meta tags.
NEXT_PUBLIC_ALLOW_INDEXING=true

# Cookie consent (CookieYes)
# Set NEXT_PUBLIC_COOKIEYES_ALLOWED_HOSTS to a comma-separated host list.
# Example: getirbakim.com,www.getirbakim.com
NEXT_PUBLIC_ENABLE_COOKIEYES=true
NEXT_PUBLIC_COOKIEYES_CLIENT_ID=
NEXT_PUBLIC_COOKIEYES_ALLOWED_HOSTS=

# =============================================================================
# Tami Payments
# =============================================================================
# Local/staging için sandbox, production için live endpoint kullanın.
TAMI_MERCHANT_NUMBER=your-merchant-number
TAMI_TERMINAL_NUMBER=your-terminal-number
TAMI_SECRET_KEY=your-tami-secret-key
TAMI_JWK_KID=your-tami-jwk-kid
TAMI_JWK_K=your-tami-jwk-k
TAMI_PAYMENT_API_BASE_URL=https://sandbox-paymentapi.tami.com.tr
TAMI_PORTAL_BASE_URL=https://sandbox-portal.tami.com.tr

# =============================================================================
# Dinamik API (Supplier) — https://dinamikapp-api.dinamik.online
# =============================================================================
DINAMIK_BASE=https://dinamikapp-api.dinamik.online
DINAMIK_APIKEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DINAMIK_SECRETKEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# VPS Squid/HTTP proxy — Dinamik API sadece whitelist IP'den (VPS) kabul eder.
# Yerel/Docker: Mac'inizden Postman'de çalışan adresin aynısı (ör. Squid 8888).
DINAMIK_PROXY_URL=http://dinamik:your-proxy-password@173.249.36.2:8888

# true: proxy zorunlu (default), false: doğrudan erişim (whitelist dışı IP'de çalışmaz)
DINAMIK_PROXY_REQUIRED=true
# Docker node:22-slim TLS via proxy — yerelde true gerekebilir; production VPS'te false bırakın
DINAMIK_PROXY_TLS_INSECURE=false
# getStockList/getPriceList zaman aşımı (ms); büyük markalar için 60000 önerilir
DINAMIK_STOCK_LIST_TIMEOUT_MS=60000
DINAMIK_BATCH_SIZE=100
DINAMIK_BRAND_CONCURRENCY=4
DINAMIK_ITEM_CONCURRENCY=25
DINAMIK_DELTA_SYNC_STALE_MS=3600000

# Internal scheduled sync route auth
CRON_SECRET=replace-with-a-long-random-secret

# =============================================================================
# SETA API (Supplier)
# =============================================================================
SETA_XAPIKEY=
SETA_API_KEY=
SETA_APIKEY=
SETA_SECRETKEY=
SETA_PRODUCTS_URL=https://b2b-api.ismyazilim.com/seta/products

# PART NO ile otomatik eşleştirme paralellik seviyesi (1-32, default: 8)
AUTO_MAP_CONCURRENCY=8

# Supplier sync concurrency
SETA_ITEM_CONCURRENCY=12
SUPPLIER_POLICY_CONCURRENCY=12

# =============================================================================
# Başbuğ API (Supplier) — https://api.basbug.com.tr
# =============================================================================
BASBUG_BASE_URL=https://api.basbug.com.tr
BASBUG_USERNAME=
BASBUG_PASSWORD=
BASBUG_CLIENT_ID=
BASBUG_CLIENT_SECRET=
BASBUG_ITEM_CONCURRENCY=4
BASBUG_ITEM_TIMEOUT_MS=30000

# =============================================================================
# Meilisearch (Self-Hosted)
# =============================================================================
# MEILI_ENABLED must be "true" to use Meilisearch for search.
# Keep MEILI_ENABLED=false until the index is built and smoke-tested.
# PostgreSQL catalog+offer search is the fallback when Meili is disabled.
MEILI_ENABLED=false

# Server-only Meilisearch connection (never expose to browser).
# Local dev (app outside Docker): http://127.0.0.1:7700
# Full Docker (app inside Docker): http://meilisearch:7700
MEILI_HOST=http://127.0.0.1:7700

# MEILI_MASTER_KEY is server-only. Do NOT expose to browser.
# Do NOT commit this key. Use a strong random string in production.
# Local dev default: local-dev-master-key (matches docker-compose.meili.yml)
MEILI_MASTER_KEY=local-dev-master-key

# MEILI_INDEX_PRODUCTS is the Meilisearch index name for products.
MEILI_INDEX_PRODUCTS=products

# v0-only catalog index (approved dpprd + dpbrd). Used when NEXT_PUBLIC_V0_ONLY_SITE is enabled.
MEILI_INDEX_V0=v0-catalog

# NEXT_PUBLIC_MEILI_HOST and NEXT_PUBLIC_MEILI_SEARCH_KEY are only needed
# if the frontend connects to Meilisearch directly. Prefer server-side
# search via /api/search instead of exposing keys to the browser.
# For local dev, these are not required — search goes through /api/search.
# NEXT_PUBLIC_MEILI_HOST=http://localhost:7700
# NEXT_PUBLIC_MEILI_SEARCH_KEY=

# =============================================================================
# Parts2World / Supplier Sync
# =============================================================================
PARTS2WORLD_BASE_URL=
PARTS2WORLD_ALLOWED_HOSTS=
PARTS2WORLD_FALLBACK_BASE_URLS=
PARTS2WORLD_CHECKPOINT_DIR=.parts2world-checkpoints

# =============================================================================
# Stack Auth
# =============================================================================
NEXT_PUBLIC_STACK_PROJECT_ID=your-stack-project-id
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=your-stack-publishable-client-key
STACK_SECRET_SERVER_KEY=your-stack-secret-server-key

# =============================================================================
# Optional runtime/debug flags
# =============================================================================
ANALYZE=false
HIERARCHY_SERVICE_DEBUG=false
PERFORMANCE_LOGGING=false
SLOW_QUERY_THRESHOLD=500
NODE_ENV=development

# Reference only. Actual production build version is injected by deploy workflow/build args.
# Do NOT set NEXT_PUBLIC_BUILD_VERSION in .env.production — it is injected at Docker build time.
NEXT_PUBLIC_BUILD_VERSION=v0.3.7

# =============================================================================
# Sentry — Error tracking and performance monitoring
# =============================================================================
# Public DSN for client-side error reporting (NEXT_PUBLIC_ prefix — safe for browser).
# This value IS embedded in client bundles and visible in browser DevTools.
# Generate at: Sentry → Settings → Projects → getirbakim → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@oxxxxx.ingest.de.sentry.io/xxxxx

# Auth token for Sentry source map uploads at build time.
# Generate at: Sentry → Settings → Auth Tokens → Create Token (project:write scope).
# This is a SECRET — NEVER commit it. Pass as Docker build arg or CI/CD env.
# Only needed during production Docker build. Not needed in .env for local dev.
#   docker compose build --build-arg SENTRY_AUTH_TOKEN=sntrys_xxxxx
SENTRY_AUTH_TOKEN=

# Sentry organization and project slugs — used by withSentryConfig at build time.
SENTRY_ORG=plantx-ye
SENTRY_PROJECT=getirbakim