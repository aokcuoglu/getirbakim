ADMIN_PASSWORD=
DINAMIK_BASE=
DINAMIK_APIKEY=
DINAMIK_SECRETKEY=
# Local only: the API allow-lists the VPS address. Tunnel through it with
# ssh -N -L 18443:dinamikapp-api.dinamik.online:443 root@173.249.36.2 and set 127.0.0.1:18443.
DINAMIK_DIRECT_TUNNEL=
# Minutes per scheduler tick in which new Dinamik brands may start (default 10).
DINAMIK_TICK_MINUTES=
BASBUG_BASE_URL=
BASBUG_USERNAME=
BASBUG_PASSWORD=
BASBUG_CLIENT_ID=
BASBUG_CLIENT_SECRET=
