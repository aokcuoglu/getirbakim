# .env.local.example — Copy to .env.local and adjust values
#
# This file overrides .env for local development (next dev).
# .env.local is gitignored — your secrets stay local.
#
# Usage:
#   cp .env.local.example .env.local
#   bun run meili:start
#   bun run dev

# =============================================================================
# Meilisearch — Local Dev (app outside Docker)
# =============================================================================
# When running `bun run dev` (app outside Docker), use localhost address.
# When running `bun run dev:docker` (full Docker), use Docker DNS: http://meilisearch:7700
MEILI_HOST=http://127.0.0.1:7700

# Must match MEILI_MASTER_KEY in docker-compose.meili.yml (defaults to local-dev-master-key)
# If your .env has a production master key, you can override it here for local dev:
# MEILI_MASTER_KEY=local-dev-master-key

MEILI_ENABLED=true

# =============================================================================
# App URL — Local Dev (port 3000)
# =============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Database — Reduce pool when VPS is also connected
# =============================================================================
# DATABASE_POOL_MAX=2