# .env.local.example — Copy to .env.local and adjust values
#
# This file overrides .env for local development (next dev).
# .env.local is gitignored — your secrets stay local.
#
# Usage:
#   cp .env.local.example .env.local
#   bun run dev

# =============================================================================
# App URL — Local Dev (port 3000)
# =============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Database — Local PostgreSQL (app outside Docker)
# =============================================================================
# docker-compose.local.yml publishes the local `getirbakim` database on 54322.
DATABASE_URL=postgresql://postgres:local-dev-postgres-password@127.0.0.1:54322/getirbakim
DIRECT_URL=postgresql://postgres:local-dev-postgres-password@127.0.0.1:54322/getirbakim
DATABASE_POOL_MAX=15

# =============================================================================
# Auth (NextAuth.js) — Local Dev
# =============================================================================
AUTH_SECRET="local-auth-secret-change-in-production-2026"
