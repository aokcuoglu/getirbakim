{
  "name": "getirbakim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:deps": "docker volume create getirbakim-postgres-data 2>/dev/null; docker volume create getirbakim-meili-data 2>/dev/null; docker compose -f docker-compose.local.yml up -d postgres meilisearch",
    "dev:deps:stop": "docker compose -f docker-compose.local.yml down",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "bun run check:unsafe-sql && bunx tsc --noEmit --pretty false --incremental false",
    "typecheck": "bunx tsc --noEmit --incremental false",
    "meili:start": "docker volume create getirbakim-meili-data 2>/dev/null; docker compose -f docker-compose.meili.yml up -d",
    "meili:stop": "docker compose -f docker-compose.meili.yml down",
    "meili:logs": "docker compose -f docker-compose.meili.yml logs -f",
    "meili:status": "docker compose -f docker-compose.meili.yml ps",
    "test": "bun test",
    "smoke:live": "bun scripts/live-smoke.ts",
    "check:unsafe-sql": "sh -c \"if rg -n 'queryRawUnsafe|executeRawUnsafe' app/api lib/actions >/dev/null; then echo 'Unsafe raw SQL API detected in API/Admin scope'; exit 1; fi\"",
    "postinstall": "prisma generate",
    "db:pull": "prisma db pull",
    "db:generate": "prisma generate",
    "db:target": "bash scripts/db-guard.sh check",
    "db:status": "bunx prisma migrate status",
    "db:diff:check": "bunx prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:migration:new": "bash scripts/db-migration-new.sh",
    "db:migrate": "bunx prisma migrate deploy",
    "search:setup": "bun scripts/meili-setup.ts",
    "search:debug-category": "bun scripts/debug-meili-category.ts"
  },
  "dependencies": {
    "@google/genai": "^1.32.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.40.0",
    "geist": "^1.7.2",
    "hono": "^4.10.8",
    "jose": "^6.1.3",
    "lucide-react": "^0.562.0",
    "meilisearch": "^0.55.0",
    "next": "^16.0.8",
    "next-auth": "^5.0.0-beta.31",
    "next-intl": "^4.5.8",
    "next-themes": "^0.4.6",
    "pg": "^8.17.1",
    "playwright": "^1.57.0",
    "postgres": "^3.4.8",
    "prisma": "^7.2.0",
    "proxy-agent": "^6.5.0",
    "puppeteer": "^24.32.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "radix-ui": "^1.4.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^3.6.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "undici": "^7.22.0",
    "use-debounce": "^10.1.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@next/bundle-analyzer": "^16.1.3",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^24.10.2",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^11.0.0",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
