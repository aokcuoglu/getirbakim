generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "catalog"]
}

// ============================================================================
// public schema — platform tables (users, orders, vehicles, Tecdoc parts)
// UNCHANGED — do not modify.
// ============================================================================

model engines {
  id           Int        @id
  fuel_type_id Int
  name         String
  created_at   DateTime?  @default(now()) @db.Timestamp(6)
  fuel_types   fuel_types @relation(fields: [fuel_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "engines_fuel_type_id_fuel_types_id_fk")

  @@schema("public")
}

model fuel_types {
  id         Int       @id
  vehicle_id Int
  name       String
  created_at DateTime? @default(now()) @db.Timestamp(6)
  engines    engines[]
  vehicles   vehicles  @relation(fields: [vehicle_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fuel_types_vehicle_id_vehicles_id_fk")

  @@schema("public")
}

model makes {
  id         Int       @id
  name       String
  url_key    String?
  is_popular Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  models     models[]

  @@schema("public")
}

model models {
  id         Int        @id
  make_id    Int
  name       String
  year_from  Int?
  year_to    Int?
  url_key    String?
  created_at DateTime?  @default(now()) @db.Timestamp(6)
  makes      makes      @relation(fields: [make_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "models_make_id_makes_id_fk")
  vehicles   vehicles[]

  @@schema("public")
}

/// Sipariş satırı KATALOG ürününe bağlanır, public.parts'a değil.
///
/// Sattığımız şey Dinamik/Başbuğ ürünlerinin kanonik katalog kaydı; public.parts
/// zenginleştirme arşivi. İki tablonun id uzayları da örtüşmüyor (aynı id iki
/// farklı ürün demek), bu yüzden eski `part_id` FK'siyle sepetten gelen katalog
/// id'si hiç kaydedilemiyordu.
///
/// `product_name` anlık kopya: ürün adı sonradan değişse ya da katalogdan düşse
/// bile siparişin ne için verildiği okunabilir kalmalı.
model order_items {
  id           Int      @id @default(autoincrement())
  order_id     Int
  product_id   BigInt
  product_name String
  quantity     Int
  price        Decimal  @db.Decimal(10, 2)
  orders       orders   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product      products @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([product_id])
  @@schema("public")
}

model order_payments {
  id                       Int       @id @default(autoincrement())
  order_id                 Int
  provider                 String
  provider_payment_id      String?
  provider_conversation_id String?
  status                   String
  amount                   Decimal   @db.Decimal(10, 2)
  currency                 String    @default("TRY")
  raw_payload              Json?
  paid_at                  DateTime? @db.Timestamp(6)
  failure_reason           String?
  created_at               DateTime  @default(now()) @db.Timestamp(6)
  updated_at               DateTime  @default(now()) @db.Timestamp(6)
  orders                   orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id, created_at])
  @@index([provider_conversation_id])
  @@index([provider_payment_id])
  @@schema("public")
}

model orders {
  id                    Int              @id @default(autoincrement())
  user_id               String?
  guest_name            String?
  guest_email           String?
  guest_phone           String?
  subtotal_amount       Decimal          @default(0) @db.Decimal(10, 2)
  shipping_fee          Decimal          @default(0) @db.Decimal(10, 2)
  total_amount          Decimal          @db.Decimal(10, 2)
  currency              String           @default("TRY")
  status                String           @default("PENDING_PAYMENT")
  payment_status        String           @default("PENDING")
  shipping_method       String?
  payment_method        String?
  shipping_address_json Json?
  note                  String?          @db.Text
  last_payment_error    String?
  stock_released_at     DateTime?        @db.Timestamp(6)
  created_at            DateTime         @default(now()) @db.Timestamp(6)
  updated_at            DateTime         @default(now()) @db.Timestamp(6)
  order_items           order_items[]
  order_payments        order_payments[]
  users                 users?           @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id])
  @@index([status])
  @@index([payment_status])
  @@index([guest_email])
  @@index([status, created_at])
  @@schema("public")
}

model customer_requests {
  id                     Int       @id @default(autoincrement())
  user_id                String?
  request_type           String
  status                 String    @default("NEW")
  source                 String
  name                   String
  email                  String
  phone                  String?
  part_id                BigInt?
  part_name_snapshot     String?
  brand_name_snapshot    String?
  category_name_snapshot String?
  page_url               String?
  locale                 String?
  vehicle_json           Json?
  search_query           String?
  requested_sku_or_oem   String?
  message                String?   @db.Text
  admin_note             String?   @db.Text
  assigned_to            String?
  resolved_at            DateTime? @db.Timestamp(6)
  created_at             DateTime  @default(now()) @db.Timestamp(6)
  updated_at             DateTime  @updatedAt @db.Timestamp(6)
  parts                  parts?    @relation(fields: [part_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  users                  users?    @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([status])
  @@index([request_type])
  @@index([source])
  @@index([created_at])
  @@index([user_id])
  @@index([part_id])
  @@index([status, created_at])
  @@index([request_type, status])
  @@schema("public")
}

model part_brands {
  id       Int     @id
  name     String  @unique
  logo_url String?
  parts    parts[]

  @@index([logo_url], name: "part_brands_logo_url_idx")
  @@schema("public")
}

model part_categories {
  id                Int        @id
  name              String
  is_active         Boolean    @default(true)
  has_childs        Boolean    @default(false)
  parent_id         Int?
  name_tr           String?
  url_key           String?
  is_main_nav       Boolean    @default(false)
  image             String?    @db.Text
  // Legacy id carried over from the original import; read by nothing today, but
  // present in the archive so the datamodel has to declare it.
  trodo_category_id BigInt?
  parts             parts[]
  products          products[]

  @@index([trodo_category_id], map: "idx_part_categories_trodo_category_id")
  @@index([name])
  @@index([name_tr])
  @@index([is_active])
  @@index([parent_id])
  @@index([url_key])
  @@index([is_main_nav])
  @@index([is_active, is_main_nav], name: "part_categories_active_main_nav_idx")
  @@index([is_active, parent_id], name: "part_categories_active_parent_idx")
  @@index([is_active, url_key], name: "part_categories_active_url_key_idx")
  @@schema("public")
}

model part_cross_references {
  id             Int    @id @default(autoincrement())
  brand_name     String
  article_number String
  part_id        BigInt
  parts          parts  @relation(fields: [part_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([article_number])
  @@index([brand_name])
  @@index([part_id])
  @@index([article_number, part_id], name: "part_cross_refs_article_part_idx")
  @@schema("public")
}

model part_documents {
  id                 Int     @id @default(autoincrement())
  doc_file_name      String
  doc_file_type_name String
  doc_id             String
  doc_type_id        Int
  doc_type_name      String
  doc_url            String?
  part_id            BigInt
  parts              parts   @relation(fields: [part_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([part_id])
  @@schema("public")
}

model part_eans {
  id      Int    @id @default(autoincrement())
  code    String
  part_id BigInt
  parts   parts  @relation(fields: [part_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([part_id, code])
  @@index([code])
  @@index([part_id], name: "part_eans_part_id_idx")
  @@schema("public")
}

model part_images {
  id      Int     @id @default(autoincrement())
  image   String?
  thumb   String?
  part_id BigInt
  parts   parts   @relation(fields: [part_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([part_id])
  @@schema("public")
}

model part_infos {
  id      Int    @id @default(autoincrement())
  content String
  part_id BigInt
  parts   parts  @relation(fields: [part_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([part_id])
  @@schema("public")
}

model part_oens {
  id      Int    @id @default(autoincrement())
  brand   String
  code    String
  part_id BigInt
  parts   parts  @relation(fields: [part_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([code])
  @@index([brand])
  @@index([part_id])
  @@index([code, part_id], name: "part_oens_code_part_idx")
  @@schema("public")
}

model part_properties {
  id      Int    @id @default(autoincrement())
  key     String
  value   String
  part_id BigInt
  parts   parts  @relation(fields: [part_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([part_id, key], map: "part_properties_part_id_key_unique")
  @@index([part_id])
  @@schema("public")
}

model part_vehicle_types {
  id              Int           @id @default(autoincrement())
  part_id         BigInt
  vehicle_type_id Int
  parts           parts         @relation(fields: [part_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vehicle_type    vehicle_types @relation(fields: [vehicle_type_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([part_id, vehicle_type_id])
  @@index([vehicle_type_id, part_id])
  @@schema("public")
}

model parts {
  id                BigInt   @id
  tecdoc_article_id BigInt?
  name              String
  // TEXT, not BIGINT: ~32% of TecDoc part numbers are alphanumeric ("10PK1342",
  // "WP6118"), so a numeric column would reject a third of the archive.
  part_no           String?
  article_link_id   BigInt
  price             Decimal? @db.Decimal(10, 2)
  in_basket         Boolean  @default(false)
  brand_id          Int
  category_id       Int
  created_at        DateTime @default(now()) @db.Timestamp(6)
  updated_at        DateTime @default(now()) @db.Timestamp(6)

  // Bookkeeping for the parts2web archive sync. Present only where the TecDoc
  // archive lives; empty in every other environment.
  p2w_sync_version           Int       @default(1)
  p2w_last_seen_at           DateTime? @db.Timestamp(6)
  p2w_last_seen_run_id       BigInt?
  p2w_article_info_synced_at DateTime? @db.Timestamp(6)
  p2w_article_info_run_id    BigInt?

  part_cross_references part_cross_references[]
  customer_requests     customer_requests[]
  part_documents        part_documents[]
  part_eans             part_eans[]
  part_images           part_images[]
  part_infos            part_infos[]
  part_oens             part_oens[]
  part_properties       part_properties[]
  part_vehicle_types    part_vehicle_types[]
  products              products[]
  product_part_links    product_part_links[]
  part_brands           part_brands             @relation(fields: [brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  part_categories       part_categories         @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([article_link_id])
  @@index([tecdoc_article_id])
  @@index([category_id])
  @@index([brand_id])
  @@index([updated_at])
  @@index([category_id, updated_at])
  @@index([category_id, brand_id])
  @@index([category_id, brand_id, updated_at])
  @@index([category_id, price])
  @@index([created_at])
  @@index([name])
  @@index([part_no])
  // Descending variants, hand-built for the archive's "newest first" scans. Kept
  // in the datamodel so `migrate diff` stops proposing to drop them.
  @@index([updated_at(sort: Desc)], map: "idx_parts_updated_at")
  @@index([category_id, updated_at(sort: Desc)], map: "idx_parts_category_updated_at")
  @@index([category_id, brand_id, updated_at(sort: Desc)], map: "idx_parts_category_brand_updated_at")
  @@index([part_no, updated_at(sort: Desc)], map: "idx_parts_part_no_text_updated_at")
  @@index([p2w_last_seen_at], map: "idx_parts_p2w_last_seen_at")
  @@index([p2w_last_seen_run_id], map: "idx_parts_p2w_last_seen_run_id")
  @@index([p2w_article_info_synced_at], map: "idx_parts_p2w_article_info_synced_at")
  @@index([p2w_article_info_run_id], map: "idx_parts_p2w_article_info_run_id")
  @@schema("public")
}

model user_vehicles {
  id           Int       @id @default(autoincrement())
  user_id      String
  vehicle_data Json
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  users        users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_vehicles_user_id_users_id_fk")

  @@schema("public")
}

model users {
  id                String              @id
  name              String
  email             String              @unique(map: "users_email_unique")
  email_verified    Boolean             @default(false)
  password_hash     String?
  image             String?
  created_at        DateTime            @db.Timestamp(6)
  updated_at        DateTime            @db.Timestamp(6)
  role              String?             @default("CUSTOMER")
  customer_requests customer_requests[]
  notifications     notifications[]
  orders            orders[]
  user_vehicles     user_vehicles[]

  @@schema("public")
}

model notifications {
  id         BigInt    @id @default(autoincrement())
  user_id    String
  type       String
  title      String
  message    String
  payload    Json?
  read_at    DateTime? @db.Timestamp(6)
  created_at DateTime  @default(now()) @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, created_at])
  @@index([user_id, read_at])
  @@schema("public")
}

model vehicles {
  id         Int          @id
  model_id   Int
  name       String
  year_from  Int?
  year_to    Int?
  url_key    String?
  created_at DateTime?    @default(now()) @db.Timestamp(6)
  fuel_types fuel_types[]
  models     models       @relation(fields: [model_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "vehicles_model_id_models_id_fk")

  @@schema("public")
}

model scrape_progress {
  id              Int      @id @default(autoincrement())
  vehicle_type_id Int
  category_id     Int
  parts_count     Int      @default(0)
  scraped_at      DateTime @default(now()) @db.Timestamp(6)

  @@unique([vehicle_type_id, category_id])
  @@index([vehicle_type_id])
  @@schema("public")
}

model oil_capacities {
  id              Int           @id @default(autoincrement())
  vehicle_type_id Int           @unique
  brand           String
  capacity        String?
  viscosity1      String?
  viscosity2      String?
  viscosity3      String?
  created_at      DateTime      @default(now()) @db.Timestamp(6)
  updated_at      DateTime      @default(now()) @db.Timestamp(6)
  vehicle_type    vehicle_types @relation(fields: [vehicle_type_id], references: [id], onDelete: Cascade)

  @@schema("public")
}

// ============================================================================
// catalog schema (cont.) — ParcaTedarik scrape + vehicle catalog (Tecdoc-light).
// Old product_mappings / products / products_oems tables DROPPED.
// ============================================================================

// ----------------------------------------------------------------------------
// ParcaTedarik scrape (preserved as-is, do not modify).
// ----------------------------------------------------------------------------

model ptdrk_brands {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  url_key        String?          @unique
  logo_url       String?
  created_at     DateTime?        @default(now()) @db.Timestamp(6)
  updated_at     DateTime?        @default(now()) @db.Timestamp(6)
  ptdrk_products ptdrk_products[]
  brand_mappings brand_mappings[]

  @@schema("catalog")
}

model ptdrk_products {
  id              Int       @id @default(autoincrement())
  ptdrk_brands_id Int
  product_id      String    @unique
  part_no         String?
  title           String
  url             String    @unique
  ref_no          String?
  sku             String?
  price_list      Decimal?  @db.Decimal(10, 2)
  price_actual    Decimal?  @db.Decimal(10, 2)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  updated_at      DateTime? @default(now()) @db.Timestamp(6)

  ptdrk_brands       ptdrk_brands         @relation(fields: [ptdrk_brands_id], references: [id], onDelete: Cascade)
  product_ptdrk_refs product_ptdrk_refs[]

  @@index([ptdrk_brands_id])
  @@index([product_id])
  @@index([sku])
  @@schema("catalog")
}

// ----------------------------------------------------------------------------
// Vehicle catalog (Tecdoc-light) — renamed from v* to vehicle_*.
// Storefront-active (hierarchy-service, search, fitment).
// ----------------------------------------------------------------------------

model vehicle_brands {
  id     Int              @id
  name   String           @unique
  models vehicle_models[]

  @@map("vehicle_brands")
  @@schema("catalog")
}

model vehicle_models {
  id        Int             @id
  name      String
  date_from String?
  date_to   String?
  brand_id  Int
  brand     vehicle_brands  @relation(fields: [brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  types     vehicle_types[]

  @@map("vehicle_models")
  @@schema("catalog")
}

model vehicle_types {
  id                    Int                     @id
  name                  String
  cc                    Int?
  fuel_type             String?
  hp                    Int?
  kwt                   Int?
  year_of_constr_from   String?
  year_of_constr_to     String?
  model_id              Int
  part_vehicle_types    part_vehicle_types[]
  product_vehicle_types product_vehicle_types[]
  oil_capacities        oil_capacities?
  details               vehicle_type_details?
  model                 vehicle_models          @relation(fields: [model_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([name], name: "vtypes_name_idx")
  @@map("vehicle_types")
  @@schema("catalog")
}

model vehicle_type_details {
  id                      BigInt        @id @default(autoincrement())
  vehicle_type_id         Int           @unique
  brake_system            String?
  car_id                  Int?
  ccm_tech                Int?
  construction_type       String?
  cylinder                Int?
  cylinder_capacity_ccm   Int?
  cylinder_capacity_liter Int?
  fuel_type               String?
  fuel_type_process       String?
  impulsion_type          String?
  manu_id                 Int?
  manu_name               String?
  mod_id                  Int?
  model_name              String?
  motor_type              String?
  power_hp_from           Int?
  power_hp_to             Int?
  power_kw_from           Int?
  power_kw_to             Int?
  type_name               String?
  type_number             Int?
  valves                  Int?
  year_of_constr_from     String?
  year_of_constr_to       String?
  rmi_type_id             Int?
  motor_codes             Json?
  raw_payload             Json?
  created_at              DateTime      @default(now()) @db.Timestamp(6)
  updated_at              DateTime      @updatedAt @db.Timestamp(6)
  vehicle_type            vehicle_types @relation(fields: [vehicle_type_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([manu_id], name: "vtype_details_manu_id_idx")
  @@index([mod_id], name: "vtype_details_mod_id_idx")
  @@index([updated_at], name: "vtype_details_updated_at_idx")
  @@map("vehicle_type_details")
  @@schema("catalog")
}

// ============================================================================
// catalog schema — supplier raw data, brand matching, canonical sellable
// catalog. Formerly split across v0 (supplier raw + brands) and catalog
// (products/offers). Now unified under a single schema.
//
// Layering:
//   1. Supplier raw   — supplier_dinamik_*, supplier_basbug_*
//   2. Brand matching — brands, brand_mappings
//   3. Canonical catalog — products, product_offers, product_oems, ...
//
// public.parts is an enrichment source only (links are disposable,
// copied data is durable).
// ============================================================================

// ----------------------------------------------------------------------------
// 1. Supplier raw tables
// ----------------------------------------------------------------------------

// Dinamik brands — deduplicated brand list from Dinamik API getBrandList.

model supplier_dinamik_brands {
  id             BigInt                      @id @default(autoincrement())
  brand          String                      @unique
  created_at     DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at     DateTime                    @default(now()) @updatedAt @db.Timestamptz(6)
  products       supplier_dinamik_products[]
  brand_mappings brand_mappings[]

  @@schema("catalog")
}

// Dinamik products — getStockList response (master record).
// oem_no is populated by the OEM bridge from ptdrk_products.ref_no
// (Dinamik API does not provide OEM numbers).

model supplier_dinamik_products {
  id           BigInt    @id @default(autoincrement())
  brand_id     BigInt
  stock_code   String
  stock_name   String?
  part_no      String?
  oem_no       String?
  barcode_1    String?
  barcode_2    String?
  barcode_3    String?
  image_url    String?
  raw          Json      @db.JsonB
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  last_seen_at DateTime  @default(now()) @db.Timestamptz(6)
  is_passive   Boolean   @default(false)
  passive_at   DateTime? @db.Timestamptz(6)

  brand                    supplier_dinamik_brands    @relation(fields: [brand_id], references: [id], onDelete: Restrict)
  cost                     supplier_dinamik_cost?
  product_offers           product_offers[]
  product_match_candidates product_match_candidates[]

  @@unique([brand_id, stock_code], map: "uq_dinamik_products_brand_stock_code")
  @@index([brand_id], map: "idx_dinamik_products_brand_id")
  @@index([stock_code])
  @@schema("catalog")
}

// Dinamik cost — getPriceList + getStock price/stock snapshot (1:1 with products).

model supplier_dinamik_cost {
  id             BigInt   @id @default(autoincrement())
  product_id     BigInt   @unique
  price          Decimal? @db.Decimal(10, 2)
  stock_qty      Int?
  campaign_rate  Decimal? @db.Decimal(6, 3)
  regional_stock Json?    @db.JsonB
  raw            Json     @db.JsonB
  last_seen_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  product supplier_dinamik_products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([last_seen_at(sort: Desc)])
  @@schema("catalog")
}

// Başbuğ brands — manufacturer brand names (uk field from MalzemeleriGetir).

model supplier_basbug_brands {
  id           BigInt   @id @default(autoincrement())
  brand        String   @unique
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt @db.Timestamptz(6)
  last_seen_at DateTime @default(now()) @db.Timestamptz(6)

  products       supplier_basbug_products[]
  brand_mappings brand_mappings[]

  @@schema("catalog")
}

// Başbuğ products — MalzemeleriGetir response (master record).
// oem_no comes directly from API (m.oe field).

model supplier_basbug_products {
  id               BigInt    @id @default(autoincrement())
  brand_id         BigInt
  malzeme_no       String
  part_no          String?
  aciklama         String?
  aciklama2        String?
  oem_no           String?
  liste_grubu_kodu String
  arac_bilgisi     String?
  motor_bilgisi    String?
  yil_araligi      String?
  birim            String?
  para_birimi      String?
  liste_fiyati     Decimal?  @db.Decimal(12, 2)
  raw              Json      @db.JsonB
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @updatedAt @db.Timestamptz(6)
  last_seen_at     DateTime  @default(now()) @db.Timestamptz(6)
  is_passive       Boolean   @default(false)
  passive_at       DateTime? @db.Timestamptz(6)

  brand                    supplier_basbug_brands         @relation(fields: [brand_id], references: [id], onDelete: Restrict)
  cost_history             supplier_basbug_cost_history[]
  product_offers           product_offers[]
  product_match_candidates product_match_candidates[]

  @@unique([brand_id, malzeme_no], map: "uq_basbug_products_brand_malzeme_no")
  @@index([brand_id])
  @@index([malzeme_no])
  @@index([oem_no])
  @@index([liste_grubu_kodu])
  @@schema("catalog")
}

// Başbuğ exchange rates — DovizBilgisiGetir, daily snapshot.

model supplier_basbug_rates {
  id          Int      @id @default(autoincrement())
  doviz_cinsi String
  alis        Decimal  @db.Decimal(18, 6)
  satis       Decimal  @db.Decimal(18, 6)
  kaynak      String   @default("BASBUG")
  tarih       DateTime @db.Date
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([doviz_cinsi, kaynak, tarih], map: "uq_basbug_rates_cinsi_kaynak_tarih")
  @@index([tarih])
  @@index([doviz_cinsi, tarih(sort: Desc)])
  @@schema("catalog")
}

// Başbuğ cost history — price snapshot per sync run (historical tracking).

model supplier_basbug_cost_history {
  id           BigInt   @id @default(autoincrement())
  product_id   BigInt
  liste_fiyati Decimal? @db.Decimal(12, 2)
  para_birimi  String?
  kur_degeri   Decimal? @db.Decimal(18, 6)
  fiyat_tl     Decimal? @db.Decimal(12, 2)
  captured_at  DateTime @default(now()) @db.Timestamptz(6)

  product supplier_basbug_products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id, captured_at(sort: Desc)])
  @@index([para_birimi])
  @@index([captured_at])
  @@schema("catalog")
}

// ----------------------------------------------------------------------------
// 2. Brand matching layer
// ----------------------------------------------------------------------------

// Canonical brand — unified brand name across all suppliers.
// Source brand mappings live in brand_mappings.

model brands {
  id           Int     @id @default(autoincrement())
  brand        String  @unique
  logo_url     String?
  /// Vitrin marka sayfası URL'i. ParcaTedarik kaldırılmadan önce onun
  /// url_key'inden türetilip kalıcılaştırıldı; boşsa brand'den slugify edilir.
  slug         String? @unique
  /// Görünen ad (ör. "Blue Print"); boşsa brand kullanılır.
  display_name String?

  brand_mappings brand_mappings[]
  products       products[]
  oem_coverage   oem_brand_coverage?

  @@index([brand], name: "idx_brands_match_brand")
  @@schema("catalog")
}

// Brand mappings — links each supplier's brand to a canonical brand.
// At least one supplier FK must be set; mapping_status controls whether
// the supplier's products participate in catalog matching.

model brand_mappings {
  id               Int     @id @default(autoincrement())
  brand_id         Int
  dinamik_brand_id BigInt?
  ptdrk_brand_id   Int?
  basbug_brand_id  BigInt?
  mapping_status   String  @default("PENDING") // PENDING | APPROVED | IGNORED
  match_method     String?

  brand         brands                   @relation(fields: [brand_id], references: [id], onDelete: Cascade)
  dinamik_brand supplier_dinamik_brands? @relation(fields: [dinamik_brand_id], references: [id], onDelete: Cascade)
  ptdrk_brand   ptdrk_brands?            @relation(fields: [ptdrk_brand_id], references: [id], onDelete: Cascade)
  basbug_brand  supplier_basbug_brands?  @relation(fields: [basbug_brand_id], references: [id], onDelete: Cascade)

  @@unique([brand_id, dinamik_brand_id, ptdrk_brand_id, basbug_brand_id], name: "uq_brand_mappings_suppliers")
  @@index([brand_id], name: "idx_brand_mappings_brand")
  @@index([dinamik_brand_id], name: "idx_brand_mappings_dinamik")
  @@index([ptdrk_brand_id], name: "idx_brand_mappings_ptdrk")
  @@index([basbug_brand_id], name: "idx_brand_mappings_basbug")
  @@index([mapping_status], name: "idx_brand_mappings_status")
  @@schema("catalog")
}

// ----------------------------------------------------------------------------
// 3. Suppliers registry
// ----------------------------------------------------------------------------

model suppliers {
  code               String    @id // 'dinamik' | 'basbug'
  name               String
  is_active          Boolean   @default(true)
  pricing_policy     Json? // consumed by resolvePricingPolicy (lib/pricing)
  config             Json?
  last_offer_sync_at DateTime? @db.Timestamptz(6)

  product_offers product_offers[]

  @@schema("catalog")
}

// ----------------------------------------------------------------------------
// 4. Canonical catalog — products, offers, enrichment
// ----------------------------------------------------------------------------

// Canonical product — one row per (brand_id, part_no_norm).
// Union of supplier rows matched under an APPROVED brand mapping.

model products {
  id                BigInt  @id @default(autoincrement())
  brand_id          Int
  part_no           String // display form (best raw variant)
  part_no_norm      String // UPPER + [^A-Z0-9] stripped — matching key
  name              String
  slug              String? @unique
  category_id       Int?
  primary_image_url String?
  status            String  @default("ACTIVE") // ACTIVE|DRAFT|HIDDEN|ARCHIVED
  primary_part_id   BigInt? // cached APPROVED enrichment link

  // offer rollup cache (refreshed by refresh-product-rollups)
  min_selling_price_try Decimal? @db.Decimal(12, 2)
  total_stock_qty       Int      @default(0)
  in_stock              Boolean  @default(false)
  offer_count           Int      @default(0)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  brand                    brands                     @relation(fields: [brand_id], references: [id], onDelete: Restrict)
  category                 part_categories?           @relation(fields: [category_id], references: [id], onDelete: SetNull)
  primary_part             parts?                     @relation(fields: [primary_part_id], references: [id], onDelete: SetNull)
  product_offers           product_offers[]
  product_oems             product_oems[]
  product_eans             product_eans[]
  product_images           product_images[]
  product_properties       product_properties[]
  product_vehicle_types    product_vehicle_types[]
  product_part_links       product_part_links[]
  product_overrides        product_overrides?
  order_items              order_items[]
  stock_reservations       stock_reservations[]
  product_match_candidates product_match_candidates[]
  product_ptdrk_refs       product_ptdrk_refs[]
  product_ref_suggestions  product_ref_suggestions[]

  @@unique([brand_id, part_no_norm], map: "uq_products_brand_partno_norm")
  @@index([part_no_norm])
  @@index([status])
  @@index([category_id, status])
  @@index([brand_id, status])
  @@index([in_stock, status])
  @@index([primary_part_id])
  @@index([updated_at])
  @@schema("catalog")
}

// Per-supplier offer — provenance FK back to the raw supplier table.
// cost → sell chain materialized at sync time.

model product_offers {
  id            BigInt @id @default(autoincrement())
  product_id    BigInt
  supplier_code String

  // provenance: exactly one supplier FK set, matching supplier_code (CHECK in migration)
  dinamik_product_id BigInt? @unique(map: "uq_offers_dinamik_product")
  basbug_product_id  BigInt? @unique(map: "uq_offers_basbug_product")
  supplier_sku       String

  // cost → sell chain, materialized at sync time
  list_price        Decimal?  @db.Decimal(12, 2)
  currency          String    @default("TRY")
  fx_rate           Decimal?  @db.Decimal(18, 6)
  fx_date           DateTime? @db.Date
  campaign_rate     Decimal?  @db.Decimal(6, 3)
  cost_try          Decimal?  @db.Decimal(12, 2)
  net_cost_try      Decimal?  @db.Decimal(12, 2)
  selling_price_try Decimal?  @db.Decimal(12, 2) // ex VAT

  stock_qty       Int   @default(0)
  stock_breakdown Json? // dinamik regional_stock passthrough

  is_active      Boolean   @default(true)
  priced_at      DateTime? @db.Timestamptz(6)
  last_synced_at DateTime  @default(now()) @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  product         products                   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  supplier        suppliers                  @relation(fields: [supplier_code], references: [code], onDelete: Restrict)
  dinamik_product supplier_dinamik_products? @relation(fields: [dinamik_product_id], references: [id], onDelete: Cascade)
  basbug_product  supplier_basbug_products?  @relation(fields: [basbug_product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, supplier_code], map: "uq_offers_product_supplier")
  @@index([supplier_code, is_active])
  @@index([supplier_code, last_synced_at])
  @@index([is_active, stock_qty])
  @@schema("catalog")
}

// OEM codes for a canonical product.

model product_oems {
  id         BigInt   @id @default(autoincrement())
  product_id BigInt
  code       String // raw as received
  code_norm  String // normalizeOem()
  // Vehicle maker (from part_oens.brand when enriched). '' = unknown, NOT null:
  // one OEM code is shared across a maker group (55284051 → FIAT / ALFA ROMEO /
  // LANCIA / ABARTH), so the brand belongs in the unique key — and a nullable
  // column cannot join a unique key (Postgres counts NULLs as distinct, so
  // ON CONFLICT DO NOTHING would stop deduping; Prisma rejects it outright).
  oem_brand  String   @default("")
  source     String // 'BSBG' | 'DNMK' | 'PARTS' | 'MANUAL' | 'PART_NO'
  created_at DateTime @default(now()) @db.Timestamptz(6)

  product products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, code_norm, oem_brand], map: "uq_product_oems_product_code_brand")
  @@index([code_norm])
  @@index([source])
  @@schema("catalog")
}

// EAN / barcode codes for a canonical product.

model product_eans {
  id         BigInt @id @default(autoincrement())
  product_id BigInt
  code       String
  source     String // 'DNMK' | 'PARTS' | 'MANUAL'

  product products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, code], map: "uq_product_eans_product_code")
  @@index([code])
  @@schema("catalog")
}

// Product images.

model product_images {
  id         BigInt  @id @default(autoincrement())
  product_id BigInt
  url        String
  thumb      String?
  position   Int     @default(0)
  source     String // 'DNMK' | 'PARTS' | 'MANUAL'

  product products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, url], map: "uq_product_images_product_url")
  @@index([product_id, position])
  @@schema("catalog")
}

// Product technical properties.

model product_properties {
  id         BigInt @id @default(autoincrement())
  product_id BigInt
  key        String
  value      String
  source     String @default("PARTS")

  product products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, key], map: "uq_product_properties_product_key")
  @@schema("catalog")
}

// Copied fitment — durable across public.parts refreshes.

model product_vehicle_types {
  id              BigInt @id @default(autoincrement())
  product_id      BigInt
  vehicle_type_id Int
  source          String @default("PARTS")

  product      products      @relation(fields: [product_id], references: [id], onDelete: Cascade)
  vehicle_type vehicle_types @relation(fields: [vehicle_type_id], references: [id], onDelete: Cascade)

  @@unique([product_id, vehicle_type_id], map: "uq_product_vehicle_types")
  @@index([vehicle_type_id, product_id])
  @@schema("catalog")
}

// Disposable bridge to public.parts — regenerated by enrich-from-parts.

model product_part_links {
  id           BigInt    @id @default(autoincrement())
  product_id   BigInt
  part_id      BigInt
  match_method String // 'OEM' | 'PART_NO' | 'CROSS_REF' | 'EAN' | 'MANUAL'
  matched_code String?
  confidence   Decimal?  @db.Decimal(4, 3)
  status       String    @default("CANDIDATE") // CANDIDATE | APPROVED | REJECTED
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  reviewed_at  DateTime? @db.Timestamptz(6)
  reviewed_by  String?

  product products @relation(fields: [product_id], references: [id], onDelete: Cascade)
  part    parts    @relation(fields: [part_id], references: [id], onDelete: Cascade)

  @@unique([product_id, part_id], map: "uq_product_part_links")
  @@index([part_id])
  @@index([status])
  @@schema("catalog")
}

// PENDING cross-supplier match candidates for human review.
// One row per (supplier raw row × candidate canonical product). Produced when an
// OEM overlap resolves to >1 product (ambiguous) — the auto-match ladder skips
// these, so they queue here for manual approve/reject.

model product_match_candidates {
  id                 BigInt    @id @default(autoincrement())
  product_id         BigInt // candidate canonical product
  supplier_code      String // 'basbug' | 'dinamik'
  dinamik_product_id BigInt?
  basbug_product_id  BigInt?
  match_method       String // 'OEM_MULTI'
  matched_code       String? // representative overlapping OEM (normalized)
  confidence         Decimal?  @db.Decimal(4, 3)
  status             String    @default("PENDING") // PENDING | APPROVED | REJECTED
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  reviewed_at        DateTime? @db.Timestamptz(6)
  reviewed_by        String?

  product         products                   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  dinamik_product supplier_dinamik_products? @relation(fields: [dinamik_product_id], references: [id], onDelete: Cascade)
  basbug_product  supplier_basbug_products?  @relation(fields: [basbug_product_id], references: [id], onDelete: Cascade)

  @@unique([basbug_product_id, product_id], map: "uq_match_cand_basbug_product")
  @@unique([dinamik_product_id, product_id], map: "uq_match_cand_dinamik_product")
  @@index([status])
  @@index([product_id])
  @@index([basbug_product_id])
  @@schema("catalog")
}

// Parçatedarik reference link — ptdrk product → canonical product.
// Reference/enrichment only (NOT a sellable offer; ptdrk has no stock).
// One row per ptdrk product; feeds OEM/price reference for the canonical.

model product_ptdrk_refs {
  id               BigInt   @id @default(autoincrement())
  product_id       BigInt
  ptdrk_product_id Int      @unique(map: "uq_ptdrk_ref_product")
  matched_code     String?
  confidence       Decimal? @db.Decimal(4, 3)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  created_by       String?

  product products       @relation(fields: [product_id], references: [id], onDelete: Cascade)
  ptdrk   ptdrk_products @relation(fields: [ptdrk_product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@schema("catalog")
}

// Web'den toplanan OEM / SEO ad önerileri — admin onayı bekleyen inceleme kuyruğu.
// Onaylananlar product_oems (source='WEB') ve product_overrides.name_override'a akar.

model product_ref_suggestions {
  id          BigInt    @id @default(autoincrement())
  product_id  BigInt
  kind        String // 'OEM' | 'NAME'
  value       String // OEM: biçimli kod · NAME: önerilen başlık
  value_norm  String // OEM: normalizeOem(value) · NAME: upper(btrim(value))
  oem_brand   String    @default("") // product_oems ile aynı sözleşme: '' = bilinmiyor
  confidence  String    @default("MEDIUM") // 'HIGH' | 'MEDIUM' | 'LOW'
  source_site String
  source_url  String?
  evidence    String?   @db.Text
  status      String    @default("PENDING") // 'PENDING' | 'APPROVED' | 'REJECTED' | 'APPLIED'
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  reviewed_at DateTime? @db.Timestamptz(6)
  reviewed_by String?
  applied_at  DateTime? @db.Timestamptz(6)

  product products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, kind, value_norm, oem_brand], map: "uq_ref_suggestions_product_kind_value")
  @@index([status, kind], map: "idx_ref_suggestions_status_kind")
  @@index([product_id], map: "idx_ref_suggestions_product")
  @@schema("catalog")
}

/// Hangi markanın OEM'ini hangi web kaynağından çekebiliyoruz.
///
/// Neden tablo: kapsam bilgisi bugüne kadar yerel dosyalarda ve kod
/// sabitlerinde duruyordu, dolayısıyla admin panelinde görünmüyordu. Oysa
/// asıl karar bu: kapsanan markalar scraper'a bırakılır, KAPSANMAYANLAR elle
/// araştırılır. İkisini ayırt edemeyen bir panel yanlış işe yönlendirir.
///
/// Ayrıca taşınabilir olmalı: TecDoc marka id'lerinin bir bölümü yerel arşivden
/// (public.part_brands) türetiliyor ve o arşiv prod'da yok — kapsam canlı
/// hesaplanamaz, materyalize edilmesi gerekir.
///
/// `scripts/refresh-oem-coverage.ts` yazar; kaynak adapter'ları okumaz.
model oem_brand_coverage {
  brand_id        Int      @id
  /// Markayı kapsayan kaynağın site kimliği; null = kapsayan kaynak YOK,
  /// yani bu markanın OEM'i elle araştırılmalı.
  source_site     String?
  /// REPXPERT ürün kodunu kuran TecDoc tedarikçi numarası (yalnız o kaynakta).
  tecdoc_brand_id Int?
  /// Kapsamın nereden bilindiği: 'archive' | 'search' | 'builtin'.
  resolved_by     String?
  checked_at      DateTime @default(now()) @db.Timestamptz(6)

  brand brands @relation(fields: [brand_id], references: [id], onDelete: Cascade)

  @@index([source_site], map: "idx_oem_brand_coverage_source")
  @@schema("catalog")
}

// Admin overrides for a canonical product.

/// Ödeme penceresi boyunca stok tutma.
///
/// Neden sayaç değil satır: `products` üzerinde bir `reserved_stock_qty` sayacı
/// tutulsaydı, ödeme webhook'u hiç gelmediğinde ya da süreç ortada çöktüğünde
/// sayaç sızar ve o stok kalıcı olarak kilitli kalırdı — kendini düzeltemez.
/// Süreli satır ise `expires_at` geçince kendiliğinden sayılmaz olur; hiçbir
/// temizlik işinin doğru çalışmasına bağlı değil.
///
/// Müsait stok = products.total_stock_qty − (ACTIVE ve süresi geçmemiş rezervlerin
/// toplamı). Stok tedarikçinin olduğu için rezerv yalnızca çifte satışı önler;
/// ödeme sonuçlandığında (başarılı ya da başarısız) satır RELEASED'a çekilir ve
/// stoğun gerçeği bir sonraki tedarikçi senkronundan gelir.
model stock_reservations {
  id         BigInt   @id @default(autoincrement())
  order_id   Int
  product_id BigInt
  quantity   Int
  /// ACTIVE | RELEASED
  status     String   @default("ACTIVE")
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  product products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@index([product_id, status, expires_at])
  @@schema("catalog")
}

model product_overrides {
  product_id             BigInt   @id
  selling_price_override Decimal? @db.Decimal(12, 2)
  lock_price             Boolean  @default(false)
  name_override          String?
  category_override_id   Int?
  note                   String?  @db.Text
  updated_by             String?
  updated_at             DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  product products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@schema("catalog")
}
