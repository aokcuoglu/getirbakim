generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "trodo", "v0"]
}

model engines {
  id           Int        @id
  fuel_type_id Int
  name         String
  created_at   DateTime?  @default(now()) @db.Timestamp(6)
  fuel_types   fuel_types @relation(fields: [fuel_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "engines_fuel_type_id_fuel_types_id_fk")
  variants     variants[]

  @@schema("public")
}

model fuel_types {
  id         Int       @id
  vehicle_id Int
  name       String
  created_at DateTime? @default(now()) @db.Timestamp(6)
  engines    engines[]
  vehicles   vehicles  @relation(fields: [vehicle_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fuel_types_vehicle_id_vehicles_id_fk")

  @@schema("public")
}

model makes {
  id         Int       @id
  name       String
  url_key    String?
  is_popular Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  models     models[]

  @@schema("public")
}

model models {
  id         Int        @id
  make_id    Int
  name       String
  year_from  Int?
  year_to    Int?
  url_key    String?
  created_at DateTime?  @default(now()) @db.Timestamp(6)
  makes      makes      @relation(fields: [make_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "models_make_id_makes_id_fk")
  vehicles   vehicles[]

  @@schema("public")
}

model order_items {
  id       Int     @id @default(autoincrement())
  order_id Int
  part_id  BigInt
  quantity Int
  price    Decimal @db.Decimal(10, 2)
  orders   orders  @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parts    parts   @relation(fields: [part_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("public")
}

model order_payments {
  id                       Int       @id @default(autoincrement())
  order_id                 Int
  provider                 String
  provider_payment_id      String?
  provider_conversation_id String?
  status                   String
  amount                   Decimal   @db.Decimal(10, 2)
  currency                 String    @default("TRY")
  raw_payload              Json?
  paid_at                  DateTime? @db.Timestamp(6)
  failure_reason           String?
  created_at               DateTime  @default(now()) @db.Timestamp(6)
  updated_at               DateTime  @default(now()) @db.Timestamp(6)
  orders                   orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id, created_at])
  @@index([provider_conversation_id])
  @@index([provider_payment_id])
  @@schema("public")
}

model orders {
  id                    Int              @id @default(autoincrement())
  user_id               String?
  guest_name            String?
  guest_email           String?
  guest_phone           String?
  subtotal_amount       Decimal          @default(0) @db.Decimal(10, 2)
  shipping_fee          Decimal          @default(0) @db.Decimal(10, 2)
  total_amount          Decimal          @db.Decimal(10, 2)
  currency              String           @default("TRY")
  status                String           @default("PENDING_PAYMENT")
  payment_status        String           @default("PENDING")
  shipping_method       String?
  payment_method        String?
  shipping_address_json Json?
  note                  String?          @db.Text
  last_payment_error    String?
  stock_released_at     DateTime?        @db.Timestamp(6)
  created_at            DateTime         @default(now()) @db.Timestamp(6)
  updated_at            DateTime         @default(now()) @db.Timestamp(6)
  order_items           order_items[]
  order_payments        order_payments[]
  users                 users?           @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id])
  @@index([status])
  @@index([payment_status])
  @@index([guest_email])
  @@index([status, created_at])
  @@schema("public")
}

model customer_requests {
  id                     Int       @id @default(autoincrement())
  user_id                String?
  request_type           String
  status                 String    @default("NEW")
  source                 String
  name                   String
  email                  String
  phone                  String?
  part_id                BigInt?
  part_name_snapshot     String?
  brand_name_snapshot    String?
  category_name_snapshot String?
  page_url               String?
  locale                 String?
  vehicle_json           Json?
  search_query           String?
  requested_sku_or_oem   String?
  message                String?   @db.Text
  admin_note             String?   @db.Text
  assigned_to            String?
  resolved_at            DateTime? @db.Timestamp(6)
  created_at             DateTime  @default(now()) @db.Timestamp(6)
  updated_at             DateTime  @updatedAt @db.Timestamp(6)
  parts                  parts?    @relation(fields: [part_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  users                  users?    @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([status])
  @@index([request_type])
  @@index([source])
  @@index([created_at])
  @@index([user_id])
  @@index([part_id])
  @@index([status, created_at])
  @@index([request_type, status])
  @@schema("public")
}

model part_brands {
  id       Int     @id
  name     String  @unique
  logo_url String?
  parts    parts[]

  @@index([logo_url], name: "part_brands_logo_url_idx")
  @@schema("public")
}

model part_categories {
  id          Int     @id
  name        String
  is_active   Boolean @default(true)
  has_childs  Boolean @default(false)
  parent_id   Int?
  name_tr     String?
  url_key     String?
  is_main_nav Boolean @default(false)
  image       String? @db.Text
  parts       parts[]

  @@index([name])
  @@index([name_tr])
  @@index([is_active])
  @@index([parent_id])
  @@index([url_key])
  @@index([is_main_nav])
  @@index([is_active, is_main_nav], name: "part_categories_active_main_nav_idx")
  @@index([is_active, parent_id], name: "part_categories_active_parent_idx")
  @@index([is_active, url_key], name: "part_categories_active_url_key_idx")
  @@schema("public")
}

model part_cross_references {
  id             Int    @id @default(autoincrement())
  brand_name     String
  article_number String
  part_id        BigInt
  parts          parts  @relation(fields: [part_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([article_number])
  @@index([brand_name])
  @@index([part_id])
  @@index([article_number, part_id], name: "part_cross_refs_article_part_idx")
  @@schema("public")
}

model part_documents {
  id                 Int     @id @default(autoincrement())
  doc_file_name      String
  doc_file_type_name String
  doc_id             String
  doc_type_id        Int
  doc_type_name      String
  doc_url            String?
  part_id            BigInt
  parts              parts   @relation(fields: [part_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([part_id])
  @@schema("public")
}

model part_eans {
  id      Int    @id @default(autoincrement())
  code    String
  part_id BigInt
  parts   parts  @relation(fields: [part_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([part_id, code])
  @@index([code])
  @@index([part_id], name: "part_eans_part_id_idx")
  @@schema("public")
}

model part_images {
  id      Int     @id @default(autoincrement())
  image   String?
  thumb   String?
  part_id BigInt
  parts   parts   @relation(fields: [part_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([part_id])
  @@schema("public")
}

model part_infos {
  id      Int    @id @default(autoincrement())
  content String
  part_id BigInt
  parts   parts  @relation(fields: [part_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([part_id])
  @@schema("public")
}

model part_oens {
  id      Int    @id @default(autoincrement())
  brand   String
  code    String
  part_id BigInt
  parts   parts  @relation(fields: [part_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([code])
  @@index([brand])
  @@index([part_id])
  @@index([code, part_id], name: "part_oens_code_part_idx")
  @@schema("public")
}

model part_properties {
  id      Int    @id @default(autoincrement())
  key     String
  value   String
  part_id BigInt
  parts   parts  @relation(fields: [part_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([part_id, key], map: "part_properties_part_id_key_unique")
  @@index([part_id])
  @@schema("public")
}

model part_vehicle_types {
  id              Int    @id @default(autoincrement())
  part_id         BigInt
  vehicle_type_id Int
  parts           parts  @relation(fields: [part_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vtypes          vtypes @relation(fields: [vehicle_type_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([part_id, vehicle_type_id])
  @@index([vehicle_type_id, part_id])
  @@schema("public")
}

model parts {
  id                    BigInt                  @id
  tecdoc_article_id     BigInt?
  name                  String
  part_no               BigInt?
  article_link_id       BigInt
  price                 Decimal?                @db.Decimal(10, 2)
  in_basket             Boolean                 @default(false)
  brand_id              Int
  category_id           Int
  created_at            DateTime                @default(now()) @db.Timestamp(6)
  updated_at            DateTime                @default(now()) @db.Timestamp(6)
  order_items           order_items[]
  part_cross_references part_cross_references[]
  customer_requests     customer_requests[]
  part_documents        part_documents[]
  part_eans             part_eans[]
  part_images           part_images[]
  part_infos            part_infos[]
  part_oens             part_oens[]
  part_properties       part_properties[]
  part_vehicle_types    part_vehicle_types[]
  part_brands           part_brands             @relation(fields: [brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  part_categories       part_categories         @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([article_link_id])
  @@index([tecdoc_article_id])
  @@index([category_id])
  @@index([brand_id])
  @@index([updated_at])
  @@index([category_id, updated_at])
  @@index([category_id, brand_id])
  @@index([category_id, brand_id, updated_at])
  @@index([category_id, price])
  @@schema("public")
}

model products_oems {
  id            BigInt   @id @default(autoincrement())
  v0_product_id BigInt
  oem_no        String
  source        String   @default("MANUAL")
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  v0_products v0_products @relation(fields: [v0_product_id], references: [id], onDelete: Cascade)

  @@unique([v0_product_id, oem_no], name: "uq_products_oems_v0_product_oem")
  @@index([oem_no], name: "idx_products_oems_oem_no")
  @@schema("v0")
}

model v0_products {
  id                BigInt   @id @default(autoincrement())
  display_name      String
  normalized_name   String?
  brand_name        String?
  brand_list_id     Int?
  primary_image_url String?
  product_mapping_id BigInt?
  status            String   @default("ACTIVE")
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  brand_list      brand_list?      @relation(fields: [brand_list_id], references: [id], onDelete: SetNull)
  product_mapping product_mapping? @relation(fields: [product_mapping_id], references: [id], onDelete: SetNull)
  products_oems   products_oems[]

  @@unique([product_mapping_id], name: "uq_v0_products_product_mapping")

  @@index([brand_list_id], name: "idx_v0_products_brand_list")
  @@index([status], name: "idx_v0_products_status")
  @@index([normalized_name], name: "idx_v0_products_normalized_name")
  @@index([product_mapping_id], name: "idx_v0_products_product_mapping")
  @@map("products")
  @@schema("v0")
}

// ==========================================
// Dinamik-ParcaTedarik Brand Alias
// Maps Dinamik brands to ParcaTedarik manufacturers
// for disambiguating model matches by brand
// ==========================================

// ==========================================
// Dinamik-ParcaTedarik Canonical Brands
// Unified brand table with unique normalized names.
// Source brand mappings live in brand_mappings.
// ==========================================

model brand_list {
  id       Int     @id @default(autoincrement())
  brand    String  @unique
  logo_url String?

  brand_mappings   brand_mappings[]
  product_mappings product_mapping[]
  v0_products      v0_products[]

  @@index([brand], name: "idx_dbrands_match_brand")
  @@schema("v0")
}

// ==========================================
// Dinamik ↔ ParçaTedarik Product Mapping
// Matches dnmk_products to ptdrk_products under approved
// brand_mappings pairs (same brand_list_id). Drives the OEM
// bridge: ptdrk_products.ref_no → dnmk_products.oem_no.
// ==========================================

model product_mapping {
  id                BigInt    @id @default(autoincrement())
  brand_list_id     Int
  dnmk_products_id  BigInt
  ptdrk_products_id Int?
  bsbg_products_id  BigInt?   @unique(map: "uq_product_mapping_bsbg")
  mapping_status    String    @default("PENDING") // PENDING|APPROVED|IGNORED
  match_method      String? // PART_NO_EXACT|MANUAL|BULK|NO_MATCH
  confidence        Decimal?  @db.Decimal(5, 4)
  oem_no            String? // Comma-separated OEM tokens written to dnmk_products.oem_no
  approved_by       String?
  approved_at       DateTime? @db.Timestamptz(6)
  ignored_at        DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  brand_list     brand_list      @relation(fields: [brand_list_id], references: [id], onDelete: Cascade)
  dnmk_products  dnmk_products   @relation(fields: [dnmk_products_id], references: [id], onDelete: Cascade)
  ptdrk_products ptdrk_products? @relation(fields: [ptdrk_products_id], references: [id], onDelete: Cascade)
  bsbg_products  bsbg_products?  @relation(fields: [bsbg_products_id], references: [id], onDelete: Cascade)

  v0_products v0_products?

  @@unique([dnmk_products_id, ptdrk_products_id], name: "uq_product_mapping_pair")
  @@index([mapping_status], name: "idx_product_mapping_status")
  @@index([brand_list_id], name: "idx_product_mapping_brand_list")
  @@index([dnmk_products_id], name: "idx_product_mapping_dnmk")
  @@index([ptdrk_products_id], name: "idx_product_mapping_ptdrk")
  @@index([bsbg_products_id], name: "idx_product_mapping_bsbg")
  @@map("product_mappings")
  @@schema("v0")
}

model brand_mappings {
  id              Int     @id @default(autoincrement())
  brand_list_id   Int
  dnmk_brands_id  BigInt?
  ptdrk_brands_id Int?
  bsbg_brands_id  BigInt?
  mapping_status  String  @default("PENDING")
  match_method    String?

  brand_list   brand_list    @relation(fields: [brand_list_id], references: [id], onDelete: Cascade)
  dnmk_brands  dnmk_brands?  @relation(fields: [dnmk_brands_id], references: [id], onDelete: Cascade)
  ptdrk_brands ptdrk_brands? @relation(fields: [ptdrk_brands_id], references: [id], onDelete: Cascade)
  bsbg_brands  bsbg_brands?  @relation(fields: [bsbg_brands_id], references: [id], onDelete: Cascade)

  @@unique([brand_list_id, dnmk_brands_id, ptdrk_brands_id, bsbg_brands_id], name: "uq_dpbrm_brands")
  @@index([brand_list_id], name: "idx_dpbrm_dpbrands")
  @@index([dnmk_brands_id], name: "idx_dpbrm_dnmk")
  @@index([ptdrk_brands_id], name: "idx_dpbrm_ptdrk")
  @@index([bsbg_brands_id], name: "idx_dpbrm_bsbg")
  @@index([mapping_status], name: "idx_dpbrm_status")
  @@schema("v0")
}

model user_vehicles {
  id           Int       @id @default(autoincrement())
  user_id      String
  vehicle_data Json
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  users        users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_vehicles_user_id_users_id_fk")

  @@schema("public")
}

model users {
  id                String              @id
  name              String
  email             String              @unique(map: "users_email_unique")
  email_verified    Boolean             @default(false)
  password_hash     String?
  image             String?
  created_at        DateTime            @db.Timestamp(6)
  updated_at        DateTime            @db.Timestamp(6)
  role              String?             @default("CUSTOMER")
  customer_requests customer_requests[]
  notifications     notifications[]
  orders            orders[]
  user_vehicles     user_vehicles[]

  @@schema("public")
}

model notifications {
  id         BigInt    @id @default(autoincrement())
  user_id    String
  type       String
  title      String
  message    String
  payload    Json?
  read_at    DateTime? @db.Timestamp(6)
  created_at DateTime  @default(now()) @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, created_at])
  @@index([user_id, read_at])
  @@schema("public")
}

model variants {
  id                  Int             @id
  engine_id           Int
  name                String
  year_from           Int?
  year_to             Int?
  ccm                 String?
  kw_ps               String?
  engine_code         String?
  url_key             String?
  tecdoc_id           Int?
  magento_id          Int?
  tags                String?
  popularity_order    Int?
  is_popular          Boolean?        @default(false)
  dropdown_id         Int?
  liters              String?
  engine_fuel         String?
  engine_liters       String?
  created_at          DateTime?       @default(now()) @db.Timestamp(6)
  category_tree_nodes category_tree[]
  engines             engines         @relation(fields: [engine_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "variants_engine_id_engines_id_fk")

  @@schema("trodo")
}

model category_tree {
  id                   BigInt   @id @default(autoincrement())
  variant_id           Int
  category_id          Int
  parent_category_id   Int?
  tree_parent_key      String
  child_position       Int
  child_category_ids   Int[]
  children_count       Int      @default(0)
  is_extra_branch      Boolean  @default(false)
  root_category_id     Int?
  current_category_id  Int?
  base_url             String?
  car_title            String?
  car_link             String?
  empty_message        String?
  name                 String
  url_key              String
  path                 String
  path_ids             Int[]
  path_depth           Int
  image_name           String?
  inherited_image_name String?
  position             Int?
  page_type            String?
  intro_html           String?
  seo_title            String?
  headline             String?
  dynamic_text         String?
  content_html         String?
  raw_attributes       Json
  created_at           DateTime @default(now()) @db.Timestamp(6)
  updated_at           DateTime @updatedAt @db.Timestamp(6)
  variants             variants @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([variant_id, category_id])
  @@index([variant_id])
  @@index([category_id])
  @@index([variant_id, parent_category_id])
  @@index([variant_id, tree_parent_key])
  @@index([variant_id, url_key])
  @@index([variant_id, page_type])
  @@index([variant_id, is_extra_branch])
  @@schema("trodo")
}

model vbrands {
  id      Int       @id
  name    String    @unique
  vmodels vmodels[]

  @@map("vbrands")
  @@schema("v0")
}

model vmodels {
  id        Int      @id
  name      String
  date_from String?
  date_to   String?
  brand_id  Int
  vbrands   vbrands  @relation(fields: [brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vtypes    vtypes[]

  @@map("vmodels")
  @@schema("v0")
}

model vtypes {
  id                  Int                  @id
  name                String
  cc                  Int?
  fuel_type           String?
  hp                  Int?
  kwt                 Int?
  year_of_constr_from String?
  year_of_constr_to   String?
  model_id            Int
  part_vehicle_types  part_vehicle_types[]
  oil_capacities      oil_capacities?
  vtype_details       vtype_details?
  vmodels             vmodels              @relation(fields: [model_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([name], name: "vtypes_name_idx")
  @@map("vtypes")
  @@schema("v0")
}

model vtype_details {
  id                      BigInt   @id @default(autoincrement())
  vehicle_type_id         Int      @unique
  brake_system            String?
  car_id                  Int?
  ccm_tech                Int?
  construction_type       String?
  cylinder                Int?
  cylinder_capacity_ccm   Int?
  cylinder_capacity_liter Int?
  fuel_type               String?
  fuel_type_process       String?
  impulsion_type          String?
  manu_id                 Int?
  manu_name               String?
  mod_id                  Int?
  model_name              String?
  motor_type              String?
  power_hp_from           Int?
  power_hp_to             Int?
  power_kw_from           Int?
  power_kw_to             Int?
  type_name               String?
  type_number             Int?
  valves                  Int?
  year_of_constr_from     String?
  year_of_constr_to       String?
  rmi_type_id             Int?
  motor_codes             Json?
  raw_payload             Json?
  created_at              DateTime @default(now()) @db.Timestamp(6)
  updated_at              DateTime @updatedAt @db.Timestamp(6)
  vtypes                  vtypes   @relation(fields: [vehicle_type_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([manu_id], name: "vtype_details_manu_id_idx")
  @@index([mod_id], name: "vtype_details_mod_id_idx")
  @@index([updated_at], name: "vtype_details_updated_at_idx")
  @@map("vtype_details")
  @@schema("v0")
}

model oil_capacities {
  id              Int      @id @default(autoincrement())
  vehicle_type_id Int      @unique
  brand           String
  capacity        String?
  viscosity1      String?
  viscosity2      String?
  viscosity3      String?
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @default(now()) @db.Timestamp(6)
  vtypes          vtypes   @relation(fields: [vehicle_type_id], references: [id], onDelete: Cascade)

  @@schema("public")
}

model vehicles {
  id         Int          @id
  model_id   Int
  name       String
  year_from  Int?
  year_to    Int?
  url_key    String?
  created_at DateTime?    @default(now()) @db.Timestamp(6)
  fuel_types fuel_types[]
  models     models       @relation(fields: [model_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "vehicles_model_id_models_id_fk")

  @@schema("public")
}

model scrape_progress {
  id              Int      @id @default(autoincrement())
  vehicle_type_id Int
  category_id     Int
  parts_count     Int      @default(0)
  scraped_at      DateTime @default(now()) @db.Timestamp(6)

  @@unique([vehicle_type_id, category_id])
  @@index([vehicle_type_id])
  @@schema("public")
}

// ==========================================
// ParcaTedarik catalog (scraped from parcatedarik.com)
// Logo/image columns moved to dnmk tables after matching
// ==========================================

model ptdrk_brands {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  url_key        String?          @unique
  logo_url       String?
  created_at     DateTime?        @default(now()) @db.Timestamp(6)
  updated_at     DateTime?        @default(now()) @db.Timestamp(6)
  ptdrk_products ptdrk_products[]
  brand_mappings brand_mappings[]

  @@schema("v0")
}

model ptdrk_products {
  id              Int       @id @default(autoincrement())
  ptdrk_brands_id Int
  product_id      String    @unique
  part_no         String?
  title           String
  url             String    @unique
  ref_no          String?
  sku             String?
  price_list      Decimal?  @db.Decimal(10, 2)
  price_actual    Decimal?  @db.Decimal(10, 2)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  updated_at      DateTime? @default(now()) @db.Timestamp(6)

  ptdrk_brands     ptdrk_brands      @relation(fields: [ptdrk_brands_id], references: [id], onDelete: Cascade)
  product_mappings product_mapping[]

  @@index([ptdrk_brands_id])
  @@index([product_id])
  @@index([sku])
  @@schema("v0")
}

// ==========================================
// Dinamik Supplier Products (was dinamik.products)
// Raw supplier product data from Dinamik API/CSV import
// ==========================================

model dnmk_products {
  id             BigInt    @id
  dnmk_brands_id BigInt
  stock_code     String
  stock_name     String?
  part_no        String?
  oem_no         String?
  barcode_1      String?
  barcode_2      String?
  barcode_3      String?
  image_url      String?
  raw            Json      @db.JsonB
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  last_seen_at   DateTime  @default(now()) @db.Timestamptz(6)
  is_passive     Boolean   @default(false)
  passive_at     DateTime? @db.Timestamptz(6)

  dnmk_brands      dnmk_brands       @relation(fields: [dnmk_brands_id], references: [id], onDelete: Restrict)
  dnmk_cost        dnmk_cost?
  product_mappings product_mapping[]

  @@unique([dnmk_brands_id, stock_code], map: "uq_dproducts_dbrands_stock_code")
  @@index([dnmk_brands_id], map: "idx_dproducts_dbrands_id")
  @@index([stock_code])
  @@schema("v0")
}

model dnmk_cost {
  id               BigInt   @id @default(autoincrement())
  dnmk_products_id BigInt   @unique
  price            Decimal? @db.Decimal(10, 2)
  stock_qty        Int?
  campaign_rate    Decimal? @db.Decimal(6, 3)
  regional_stock   Json?    @db.JsonB
  raw              Json     @db.JsonB
  last_seen_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  dnmk_products dnmk_products @relation(fields: [dnmk_products_id], references: [id], onDelete: Cascade)

  @@index([last_seen_at(sort: Desc)])
  @@schema("v0")
}

// ==========================================
// Dinamik Brands (was dinamik.brands)
// Deduplicated brand name list from Dinamik
// ==========================================

model dnmk_brands {
  id             BigInt           @id @default(autoincrement())
  brand          String           @unique
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  // Canonical brand mappings moved to brand_mappings
  dnmk_products  dnmk_products[]
  brand_mappings brand_mappings[]

  @@schema("v0")
}

// ==========================================
// Başbuğ Brands — üretici markaları (uk alanı)
// Deduplicated brand name list from Başbuğ API
// ==========================================

model bsbg_brands {
  id           BigInt   @id @default(autoincrement())
  brand        String   @unique
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt @db.Timestamptz(6)
  last_seen_at DateTime @default(now()) @db.Timestamptz(6)

  bsbg_products  bsbg_products[]
  brand_mappings brand_mappings[]

  @@schema("v0")
}

// ==========================================
// Başbuğ Products — MalzemeleriGetir response
// Raw supplier product data from Başbuğ API
// ==========================================

model bsbg_products {
  id               BigInt    @id @default(autoincrement())
  bsbg_brands_id   BigInt
  malzeme_no       String
  part_no          String?
  aciklama         String?
  aciklama2        String?
  oem_no           String?
  liste_grubu_kodu String
  arac_bilgisi     String?
  motor_bilgisi    String?
  yil_araligi      String?
  birim            String?
  para_birimi      String?
  liste_fiyati     Decimal?  @db.Decimal(12, 2)
  raw              Json      @db.JsonB
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @updatedAt @db.Timestamptz(6)
  last_seen_at     DateTime  @default(now()) @db.Timestamptz(6)
  is_passive       Boolean   @default(false)
  passive_at       DateTime? @db.Timestamptz(6)

  bsbg_brands     bsbg_brands     @relation(fields: [bsbg_brands_id], references: [id], onDelete: Restrict)
  bsbg_cost       bsbg_cost[]
  product_mapping product_mapping?

  @@unique([bsbg_brands_id, malzeme_no], map: "uq_bsbg_products_brand_malzeme_no")
  @@index([bsbg_brands_id])
  @@index([malzeme_no])
  @@index([oem_no])
  @@index([liste_grubu_kodu])
  @@schema("v0")
}

// ==========================================
// Başbuğ Exchange Rates — DovizBilgisiGetir
// Daily snapshot with historical tracking
// ==========================================

model bsbg_rate {
  id          Int      @id @default(autoincrement())
  doviz_cinsi String
  alis        Decimal  @db.Decimal(18, 6)
  satis       Decimal  @db.Decimal(18, 6)
  kaynak      String   @default("BASBUG")
  tarih       DateTime @db.Date
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([doviz_cinsi, kaynak, tarih], map: "uq_bsbg_rate_cinsi_kaynak_tarih")
  @@index([tarih])
  @@index([doviz_cinsi, tarih(sort: Desc)])
  @@schema("v0")
}

// ==========================================
// Başbuğ Cost History — MalzemeleriGetir fiyat snapshotları
// Her sync'te her ürün için bir satır — historical tracking
// ==========================================

model bsbg_cost {
  id               BigInt   @id @default(autoincrement())
  bsbg_products_id BigInt
  liste_fiyati     Decimal? @db.Decimal(12, 2)
  para_birimi      String?
  kur_degeri       Decimal? @db.Decimal(18, 6)
  fiyat_tl         Decimal? @db.Decimal(12, 2)
  captured_at      DateTime @default(now()) @db.Timestamptz(6)

  bsbg_products bsbg_products @relation(fields: [bsbg_products_id], references: [id], onDelete: Cascade)

  @@index([bsbg_products_id, captured_at(sort: Desc)])
  @@index([para_birimi])
  @@index([captured_at])
  @@schema("v0")
}
